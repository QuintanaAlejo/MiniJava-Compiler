.DATA
VT_A: NOP ; Clase sin metodos dinamicos

.CODE
.CODE
CONSTRUCTOR_A:
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

.CODE
A_mc: NOP ; Inicio método mc
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
PUSH 1234
LOAD 3
LOAD 3
LOADREF 0
LOADREF 2
CALL
PUSH 33
LOAD 3
LOAD 3
LOADREF 0
LOADREF 2
CALL
STOREFP   ; Restaura FP anterior
RET 0
; Fin del metodomc

.DATA
VT_Init: NOP ; Clase sin metodos dinamicos

.CODE
.CODE
CONSTRUCTOR_Init:
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

.CODE
Init_main: NOP ; Inicio método main
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
RMEM 1 ; Reserva memoria para la variable local a
RMEM 1 ; Reservo espacio
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT_Init ; Cargo la vtable de la clase
STOREREF 0 ; Almaceno la vtable en la instancia
DUP
PUSH CONSTRUCTOR_A ; Direccion del constructor
CALL 
STORE -1 ; Almacena el valor de la expresion
STOREFP   ; Restaura FP anterior
RET 0
; Fin del metodomain

