.CODE
PUSH simple_heap_init
CALL
PUSH Init_main
CALL
HALT
simple_heap_init: RET 0 ; Retorna inmediatamente

simple_malloc: LOADFP

LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1
; Clase Object
Object_debugPrint:
LOADFP
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP
RET 1
; Clase System
System_read:
LOADFP
LOADSP
STOREFP
READ
STORE 3
STOREFP
RET 0
System_printB:
LOADFP
LOADSP
STOREFP
LOAD 3
BPRINT
STOREFP
RET 1
System_printC:
LOADFP
LOADSP
STOREFP
LOAD 3
CPRINT
STOREFP
RET 1
System_printI:
LOADFP
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP
RET 1
System_printS:
LOADFP
LOADSP
STOREFP
LOAD 3
SPRINT
STOREFP
RET 1
System_println:
LOADFP
LOADSP
STOREFP
PRNLN
STOREFP
RET 0
System_printBln:
LOADFP
LOADSP
STOREFP
LOAD 3
BPRINT
PRNLN
STOREFP
RET 1
System_printCln:
LOADFP
LOADSP
STOREFP
LOAD 3
CPRINT
PRNLN
STOREFP
RET 1
System_printIln:
LOADFP
LOADSP
STOREFP
LOAD 3
IPRINT
PRNLN
STOREFP
RET 1
System_printSln:
LOADFP
LOADSP
STOREFP
LOAD 3
SPRINT
PRNLN
STOREFP
RET 1
.DATA
VT_A: DW A_m1,A_m2 ; Etiquetas de metodo de A

.CODE
CONSTRUCTOR_A:
LOADFP
LOADSP
STOREFP
FMEM 0; Constructor
STOREFP
RET 1

.CODE
A_m1:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
LOAD 4; Accedo variable local o parametro
PUSH Object_debugPrint
CALL 
FMEM 0
STOREFP   ; Restaura FP anterior
RET 2
; Fin del metodom1

.CODE
A_m2:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
PUSH 33
STORE 4; NodoReturn
STOREFP
RET 1
FMEM 0
STOREFP   ; Restaura FP anterior
RET 1
; Fin del metodom2

.DATA
VT_Init: NOP 

.CODE
CONSTRUCTOR_Init:
LOADFP
LOADSP
STOREFP
FMEM 0; Constructor
STOREFP
RET 1

.CODE
Init_main:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
RMEM 1 ; Reserva memoria para la variable local x
RMEM 1 ; Reservo espacio
PUSH 1; NodoLlamadaConstructor
PUSH simple_malloc
CALL
DUP
PUSH VT_A ; Cargo la vtable de la clase
STOREREF 0 ; Almaceno la vtable en la instancia
DUP
PUSH CONSTRUCTOR_A ; Direccion del constructor
CALL 
STORE 0 ; Almacena el valor de la expresion
LOAD 0; Accedo variable local o parametro
RMEM 1
SWAP
DUP
LOADREF 0; Cargo VT
LOADREF 1; Cargo el metodo m2
CALL
POP
LOAD 0; Accedo variable local o parametro
RMEM 1
SWAP
DUP
LOADREF 0; Cargo VT
LOADREF 1; Cargo el metodo m2
CALL
PUSH Object_debugPrint
CALL 
FMEM 1
STOREFP   ; Restaura FP anterior
RET 0
; Fin del metodomain

