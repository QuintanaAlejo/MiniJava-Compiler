.CODE
.CODE
CONSTRUCTOR_B:
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

.CODE
B_seta4: NOP ; Inicio método seta4
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
PUSH 4000
PUSH 55
STOREFP   ; Restaura FP anterior
RET 0
; Fin del metodoseta4

.CODE
B_m2: NOP ; Inicio método m2
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
LOAD 3
LOAD 3
LOADREF 0
LOADREF 2
CALL
LOAD 3
LOAD 3
LOADREF 0
LOADREF 2
CALL
STOREFP   ; Restaura FP anterior
