.CODE
PUSH simple_heap_init
CALL
PUSH Init_main
CALL
HALT
simple_heap_init: RET 0 ; Retorna inmediatamente

simple_malloc: LOADFP

LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1
; Clase Object
Object_debugPrint:
LOADFP
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP
RET 1
; Clase System
System_read:
LOADFP
LOADSP
STOREFP
READ
STORE 3
STOREFP
RET 0
System_printB:
LOADFP
LOADSP
STOREFP
LOAD 3
BPRINT
STOREFP
RET 1
System_printC:
LOADFP
LOADSP
STOREFP
LOAD 3
CPRINT
STOREFP
RET 1
System_printI:
LOADFP
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP
RET 1
System_printS:
LOADFP
LOADSP
STOREFP
LOAD 3
SPRINT
STOREFP
RET 1
System_println:
LOADFP
LOADSP
STOREFP
PRNLN
STOREFP
RET 0
System_printBln:
LOADFP
LOADSP
STOREFP
LOAD 3
BPRINT
PRNLN
STOREFP
RET 1
System_printCln:
LOADFP
LOADSP
STOREFP
LOAD 3
CPRINT
PRNLN
STOREFP
RET 1
System_printIln:
LOADFP
LOADSP
STOREFP
LOAD 3
IPRINT
PRNLN
STOREFP
RET 1
System_printSln:
LOADFP
LOADSP
STOREFP
LOAD 3
SPRINT
PRNLN
STOREFP
RET 1
.DATA
VT_A: DW A_m1,A_setall ; Etiquetas de metodo de A

.CODE
CONSTRUCTOR_A:
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

.CODE
A_m1:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
LOAD 3; Accedo atributo
LOADREF 1
PUSH Object_debugPrint
CALL 
LOAD 3; Accedo atributo
LOADREF 2
PUSH Object_debugPrint
CALL 
LOAD 3; Accedo atributo
LOADREF 3
PUSH System_printSln   ; Apilo el metodo
CALL   ; Llamo al metodo
FMEM 0
STOREFP   ; Restaura FP anterior
RET 1
; Fin del metodom1

.CODE
A_setall:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
LOAD 4; Accedo variable local o parametro
LOAD 3; Accedo atributo
SWAP
STOREREF 1
LOAD 3; Accedo atributo
LOADREF 1
PUSH 2
MUL
LOAD 3; Accedo atributo
SWAP
STOREREF 2
.DATA
str_0: DW "hola", 0
.CODE
PUSH str_0
LOAD 3; Accedo atributo
SWAP
STOREREF 3
FMEM 0
STOREFP   ; Restaura FP anterior
RET 2
; Fin del metodosetall

.DATA
VT_B: DW A_m1,A_setall,B_seta4,B_m2 ; Etiquetas de metodo de B

.CODE
CONSTRUCTOR_B:
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

.CODE
B_seta4:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
PUSH 4000
LOAD 3; Accedo atributo
SWAP
STOREREF 4
PUSH 55
LOAD 3; Accedo atributo
SWAP
STOREREF 5
FMEM 0
STOREFP   ; Restaura FP anterior
RET 1
; Fin del metodoseta4

.CODE
B_m2:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
LOAD 3; Accedo atributo
LOADREF 4
PUSH Object_debugPrint
CALL 
LOAD 3; Accedo atributo
LOADREF 5
PUSH Object_debugPrint
CALL 
FMEM 0
STOREFP   ; Restaura FP anterior
RET 1
; Fin del metodom2

.DATA
VT_Init: NOP 

.CODE
CONSTRUCTOR_Init:
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

.CODE
Init_main:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
RMEM 1 ; Reserva memoria para la variable local x
RMEM 1 ; Reservo espacio
PUSH 6; NodoLlamadaConstructor
PUSH simple_malloc
CALL
DUP
PUSH VT_B ; Cargo la vtable de la clase
STOREREF 0 ; Almaceno la vtable en la instancia
DUP
PUSH CONSTRUCTOR_B ; Direccion del constructor
CALL 
STORE 0 ; Almacena el valor de la expresion
LOAD 0; Accedo variable local o parametro
DUP
LOADREF 0; Cargo VT
LOADREF 2; Cargo el metodo seta4
CALL
LOAD 0; Accedo variable local o parametro
PUSH 1234
SWAP
DUP
LOADREF 0; Cargo VT
LOADREF 1; Cargo el metodo setall
CALL
LOAD 0; Accedo variable local o parametro
DUP
LOADREF 0; Cargo VT
LOADREF 0; Cargo el metodo m1
CALL
LOAD 0; Accedo variable local o parametro
DUP
LOADREF 0; Cargo VT
LOADREF 3; Cargo el metodo m2
CALL
FMEM 1
STOREFP   ; Restaura FP anterior
RET 0
; Fin del metodomain

