.DATA
VT_A: NOP ; Clase sin metodos dinamicos

.CODE
.CODE
CONSTRUCTOR_A:
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

.CODE
A_m1: NOP ; Inicio método m1
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
LOAD 3
LOAD 3
LOADREF 0
LOADREF 2
CALL
LOAD 3
LOAD 3
LOADREF 0
LOADREF 2
CALL
PUSH System_printSln   ; Apilo el metodo
CALL   ; Llamo al metodo
STOREFP   ; Restaura FP anterior
RET 0
; Fin del metodom1

.CODE
A_setall: NOP ; Inicio método setall
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
PUSH 2
MUL
PUSH hola ; Cargo el string
STOREFP   ; Restaura FP anterior
RET 1
; Fin del metodosetall

.DATA
