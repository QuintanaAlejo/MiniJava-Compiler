.CODE
PUSH simple_heap_init
CALL
PUSH Init_main
CALL
HALT
simple_heap_init: RET 0 ; Retorna inmediatamente

simple_malloc: LOADFP

LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1
; Clase Object
Object_debugPrint:
LOADFP
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP
RET 1
; Clase System
