.DATA
VT_Init: NOP 

.CODE
CONSTRUCTOR_Init:
LOADFP
LOADSP
STOREFP
FMEM 0; Constructor
STOREFP
RET 1

.CODE
Init_main:
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
PUSH 1234
PUSH Object_debugPrint
CALL 
FMEM 0
STOREFP   ; Restaura FP anterior
RET 0
; Fin del metodomain

